# .env.example — RisingWave Streaming Integration Hub Environment Template
#
# Copy this file to .env.development or .env.localdev:
#   cp .env.example .env.development
#
# For local Docker setup:
DBT_RW_HOST=localhost
DBT_RW_PORT=4566
DBT_RW_USER=root
DBT_RW_PASSWORD=root
DBT_RW_DBNAME=dev

# Optional: Remote HashiCorp Vault (if using centralized secret management)
# VaultOptions__Server=https://vault.example.com
# VaultOptions__Prefix=risingwave/
# VaultOptions__Secrets=dev
# VaultOptions__TokenId=

# Operational Sink Controls:
# Set to 'paused' to pause streaming to sinks while keeping tables active
# FORVALTER_SINK_MODE=running
# KUNDEPORTAL_SINK_MODE=running
# SUPEROFFICE_SINK_MODE=running
# BQ_SINK_MODE=running
