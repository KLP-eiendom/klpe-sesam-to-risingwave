# default.env — KdiRisingWave local developer setup template
#
# Copy this file to .env.development (gitignored) and fill in your Vault token.
# All actual secrets (DB passwords, API keys, service accounts) are stored in
# HashiCorp Vault and fetched automatically by deploy.sh via
# dbt/scripts/fetch_vault_secrets.py.
#
# To get a Vault token (expires after 8h):
#   vault login -address=https://vault.example.com
#   vault token create -address=https://vault.example.com -period=8h
#
# To renew an expiring token:
#   vault token renew -address=https://vault.example.com
#
# Vault secret paths:
#   dev  → kv/risingwave/dev
#   test → kv/risingwave/test
#   prod → kv/risingwave/prod
#
# For localdev (./deploy.sh localdev): Vault is skipped.
# Put all vars you need directly in .env.localdev.

# ── Required: Vault connection ────────────────────────────────────────────────
VaultOptions__Server=https://vault.example.com
VaultOptions__Prefix=risingwave/
VaultOptions__Secrets=dev          # change to test or prod for other envs

# ── Required: Auth (choose one) ───────────────────────────────────────────────
# VaultOptions__TokenId=           # short-lived token (max 8h) — typical for local dev
# VaultOptions__K8TokenId=         # K8s SA token — used in GKE/CI deployments
# VaultOptions__VaultRoleName=     # required when using K8TokenId

# ── Optional: Operational flags ───────────────────────────────────────────────
# Uncomment to pause a sink (keeps Sesam authoritative while RisingWave sink exists) valid values is 'paused' or 'running':
# FORVALTER_SINK_MODE=paused
# KUNDEPORTAL_SINK_MODE=paused
# SUPEROFFICE_SINK_MODE=paused
# BQ_SINK_MODE=paused
# LEKO_SINK_MODE=paused
# POWERAPP_SINK_MODE=paused
# FINDABLE_SINK_MODE=paused
# MILJOPROFIL_SINK_MODE=paused

# Dalux (snk_leverandor_dalux) ships paused. Unlike the commented-out examples above, this
# line is ACTIVE on purpose: deploy.sh defaults an absent value to 'running', so a
# commented-out 'paused' would be no pause at all. The write-back has never run against a
# real Dalux environment, and the classification rule can deactivate vendors there —
# review the compiled sink SELECT before switching to 'running'.
DALUX_SINK_MODE=paused

# ── Optional: Local overrides ─────────────────────────────────────────────────
# Place any per-machine overrides in .env.localdev (applied last, overrides Vault).
# Example:
#   DBT_RW_HOST=localhost    # if running local RisingWave via Docker
