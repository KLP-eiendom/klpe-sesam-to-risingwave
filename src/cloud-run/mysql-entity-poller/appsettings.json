{
  "Logging": {
    "LogLevel": {
      "Default": "Warning"
    }
  },
  "VaultOptions": {
    "Server": "https://vault.example.com",
    "Prefix": "kdi/",
    "Secrets": [
      "dev"
    ],
    "UseVaultSharp": true
  },
  "MysqlPollerSettings": {
    "Username": "",
    "Password": "",
    "Databases": [
      {
        "Host": "localhost",
        "Port": 3306,
        "DatabaseName": "forvalter-db-dev",
        "Tables": [
          {
            "TableName": "BrukerRolle",
            "TargetTable": "stg_forvalter_brukerrolle",
            "IdExpression": "Id",
            "EnableReconciliation": true
          },
          {
            "TableName": "ProsjektProsess",
            "TargetTable": "stg_forvalter_prosjektprosess",
            "IdExpression": "concat(ProsjektId, \"-\", ProsessInstansId)",
            "EnableReconciliation": true
          },
          {
            "TableName": "DokumentKontraktlinjeAvsjekk",
            "TargetTable": "stg_forvalter_dokumentkontraktslinjeavsjekk",
            "IdExpression": "concat(DokumentId, \"-\", KontraktLinjeId)",
            "EnableReconciliation": true
          }
        ]
      },
      {
        "Host": "localhost",
        "Port": 3306,
        "DatabaseName": "kundeportal-db-dev",
        "Tables": [
          {
            "TableName": "ByggTegning",
            "TargetTable": "stg_kundeportal_byggtegning",
            "IdExpression": "UniqueId",
            "EnableReconciliation": true
          },
          {
            "TableName": "Sakskategori",
            "TargetTable": "stg_kundeportal_ticketcategory",
            "IdExpression": "concat(SakskategoriId, \"-\", System, \"-\", Type)",
            "EnableReconciliation": true
          }
        ]
      }
    ]
  },
  "RisingWaveSettings": {
    "Database": "dev",
    "Schema": "public",
    "SqlHost": "risingwave.example.com",
    "SqlPort": 4566,
    "SqlUsername": "risingwave",
    "SqlPassword": "",
    "BatchSize": 500,
    "SslEnabled": true
  }
}
