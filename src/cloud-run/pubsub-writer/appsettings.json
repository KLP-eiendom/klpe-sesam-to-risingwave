{
  "Logging": {
    "LogLevel": {
      "Default": "Warning"
    }
  },
  "Authentication": {
    "Authority": "https://auth-dev.klpeiendom.no"
  },
  "VaultOptions": {
    "Server": "https://vault.example.com",
    "Prefix": "kdi/",
    "Secrets": [
      "dev"
    ],
    "UseVaultSharp": true
  },
  "WriterSettings": {
    "ProjectId": "example-project-dev",
    "CredentialsJson": "",
    "Env": "dev",
    "Destinations": [
      {
        "Name": "superoffice",
        "Enabled": true,
        "BaseUrl": "https://api-dev.klpeiendom.no/kdi/superoffice",
        "OAuth": {
          "TokenUrl": "https://auth-dev.klpeiendom.no/connect/token",
          "ClientId": "",
          "ClientSecret": "",
          "Scope": "superofficeapi"
        }
      },
      {
        "Name": "leko",
        "Enabled": false,
        "BaseUrl": "https://europe-west2-example-project-dev.cloudfunctions.net",
        "SyncToken": "placeholder"
      },
      {
        "Name": "dalux",
        "Enabled": true,
        "BaseUrl": "https://fm-api.dalux.com/api",
        "ApiKeyHeader": "X-API-Key",
        "ApiKey": ""
      },
      {
        "Name": "document",
        "Enabled": true,
        "BaseUrl": "https://api-dev.klpeiendom.no/kdi/document",
        "OAuth": {
          "TokenUrl": "https://auth-dev.klpeiendom.no/connect/token",
          "ClientId": "",
          "ClientSecret": "",
          "Scope": "documentapi"
        }
      }
    ],
    "Subscriptions": [
      {
        "SubscriptionIdPrefix": "kredittvurdering-superoffice-worker",
        "Destination": "superoffice",
        "Path": "contact/userDefinedFields",
        "MaxMessages": 100,
        "PrimaryKey": "ContactId"
      },
      {
        "SubscriptionIdPrefix": "leverandorvurdering-superoffice-worker",
        "Destination": "superoffice",
        "Path": "contact/userDefinedFields",
        "MaxMessages": 100,
        "PrimaryKey": "contactId"
      },
      {
        "SubscriptionIdPrefix": "leverandor-omsetning-superoffice-worker",
        "Destination": "superoffice",
        "Path": "contact/userDefinedFields",
        "MaxMessages": 100,
        "PrimaryKey": "contactId"
      },
      {
        "SubscriptionIdPrefix": "kunde-leie-superoffice-worker",
        "Destination": "superoffice",
        "Path": "contact/userDefinedFields",
        "MaxMessages": 100,
        "PrimaryKey": "kundenummer"
      },
      {
        "SubscriptionIdPrefix": "document-vertex-worker",
        "Destination": "document",
        "Path": "vertex",
        "MaxMessages": 10
      },
      {
        "SubscriptionIdPrefix": "customer-leko-worker",
        "Destination": "leko",
        "Path": "api/tenant/sessam/sync",
        "MaxMessages": 100,
        "PrimaryKey": "Id",
        "NameKey": "name"
      },
      {
        "SubscriptionIdPrefix": "bygg-leko-worker",
        "Destination": "leko",
        "Path": "api/building/sessam/sync",
        "MaxMessages": 100,
        "PrimaryKey": "id",
        "NameKey": "name"
      },
      {
        "SubscriptionIdPrefix": "user-leko-worker",
        "Destination": "leko",
        "Path": "api/klp-user/sessam/sync",
        "MaxMessages": 100,
        "PrimaryKey": "id",
        "NameKey": "firstName"
      },
      {
        "SubscriptionIdPrefix": "leverandor-dalux-worker",
        "Destination": "dalux",
        "Path": "2.1/companies",
        "Method": "PATCH",
        "IdField": "companyId",
        "ExcludeIdFieldFromBody": true,
        "WrapInProperty": "data",
        "StripNullProperties": true,
        "MaxMessages": 100,
        "PrimaryKey": "companyId",
        "NameKey": "name",
        "NestedObjects": {
          "address": {
            "road": "address_road",
            "zipCode": "address_zipcode",
            "city": "address_city"
          }
        },
        "UserDefinedFields": {
          "SourceField": "userDefinedFields",
          "Map": {
            "Klassifisering": "klassifisering",
            "Org.nr.": "organisasjonsnummer",
            "Lokasjon": "lokasjon",
            "Vurderingskommentar": "evalueringskommentar"
          }
        }
      },
      {
        "SubscriptionIdPrefix": "prosjekt-juridiskselskap-superoffice-worker",
        "Destination": "superoffice",
        "Path": "project/userDefinedFields",
        "MaxMessages": 100,
        "PrimaryKey": "projectId",
        "NameKey": "Navn"
      }
    ]
  }
}
