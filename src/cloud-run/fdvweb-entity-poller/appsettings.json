{
  "Logging": {
    "LogLevel": {
      "Default": "Warning"
    }
  },
  "VaultOptions": {
    "Server": "https://vault.example.com",
    "Prefix": "kdi/",
    "Secrets": [
      "dev"
    ],
    "UseVaultSharp": true
  },
  "FdvwebApiSettings": {
    "BaseUrl": "https://eksternapi.fdvweb.no",
    "ClientId": "",
    "ClientSecret": "",
    "Scope": "",
    "TokenUrl": "https://eksternapi.fdvweb.no/connect/token",
    "Entities": [
      {
        "EntityPath": "GetBygg",
        "TargetTable": "stg_fdvweb_building",
        "IdExpression": "byggNavnId",
        "EnableReconciliation": true
      },
      {
        "EntityPath": "GetByggBilde",
        "TargetTable": "stg_fdvweb_building_image",
        "IdExpression": "concat(byggNavnId, \"-\", bildearkivTekst)",
        "EnableReconciliation": true
      }
    ]
  },
  "RisingWaveSettings": {
    "Database": "dev",
    "Schema": "public",
    "SqlHost": "risingwave.example.com",
    "SqlPort": 4566,
    "SqlUsername": "risingwave",
    "SqlPassword": "",
    "BatchSize": 500,
    "SslEnabled": true
  }
}
